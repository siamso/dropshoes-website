---
// The oversized, right-aligned headline. Lines rise into place on load and
// the type scales so the longest line always fits the container.
interface Props {
  lines: string[];
  note?: string[];
  /** Width of the longest line in ems. Estimated from its length when omitted. */
  fit?: number;
}
const { lines, note } = Astro.props;
const longest = Math.max(...lines.map((line) => line.length));
const fit = (Astro.props.fit ?? Math.max(longest * 0.8 + (note ? 1.3 : 0.2), 4.2)).toFixed(2);
---

<h1 class="big-title" style={`--fit: ${fit}`}>
  {
    lines.map((line, index) => (
      <span class="line">
        <span class="line__inner" style={`--i: ${index}`}>
          {line}
        </span>
        {note && index === lines.length - 1 && (
          <span class="note" style={`--i: ${lines.length}`}>
            {note.map((part) => (
              <span>{part}</span>
            ))}
          </span>
        )}
      </span>
    ))
  }
</h1>

<style lang="scss">
  @use "../styles/abstracts" as *;

  .big-title {
    --available: calc(100vw - var(--sidebar-w) - var(--gutter) * 2);

    font-size: min(14rem, min(var(--available), 75rem) / var(--fit));
    font-weight: bold;
    letter-spacing: -0.022em;
    line-height: 1.03;
    text-align: end;
    user-select: none;
  }

  .line {
    display: flex;
    align-items: center;
    justify-content: end;
    overflow: hidden;
    // room for descenders inside the clipping mask
    padding-block-end: 0.14em;
    margin-block-end: -0.14em;
  }

  .line__inner {
    display: block;
    white-space: nowrap;
    animation: rise 1s $ease-out both;
    animation-delay: calc(var(--i) * 140ms + 100ms);
  }

  .note {
    display: grid;
    font-size: 0.2857em;
    letter-spacing: -0.03em;
    line-height: 0.8;
    margin-inline-start: 0.5em;
    text-align: start;
    animation: pop-in 700ms $ease-out both;
    animation-delay: calc(var(--i) * 140ms + 500ms);
  }
</style>
