---
import { getImage } from "astro:assets";
import Icon from "./Icon.astro";
import { products } from "../data/products";

// A small catalogue for the browser, so the cart can render any product.
const catalog: Record<string, object> = {};
for (const product of products) {
  const thumb = await getImage({ src: product.image, width: 240, format: "webp" });
  catalog[product.slug] = {
    name: product.name,
    price: product.price,
    category: product.category,
    image: thumb.src,
    tile: product.tile,
  };
}
---

<script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />

<div class="cart-drawer" data-cart-drawer hidden>
  <div class="cart-drawer__scrim" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-title" tabindex="-1">
    <header>
      <h2 id="cart-title">Cart <span data-cart-count>(0)</span></h2>
      <button type="button" data-cart-close aria-label="Close cart"><Icon name="close" /></button>
    </header>
    <ul class="cart-lines" role="list" data-cart-lines></ul>
    <div class="cart-empty" data-cart-empty>
      <p>Nothing in here yet.</p>
      <a class="button" href="/shop">Go find a pair</a>
    </div>
    <footer data-cart-footer>
      <p class="cart-total"><span>Subtotal</span> <strong data-cart-total>$0</strong></p>
      <p class="cart-note">Shipping is free over $150.</p>
      <a class="button" data-type="primary" data-size="full" href="/checkout">Checkout <Icon name="arrow-right" /></a>
    </footer>
  </aside>
</div>

<style lang="scss" is:global>
  @use "../styles/abstracts" as *;

  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;

    &[hidden] {
      display: none;
    }

    &__scrim {
      position: absolute;
      inset: 0;
      background-color: rgb(0 0 0 / 0.45);
      opacity: 0;
      transition: opacity 400ms ease;
    }

    &__panel {
      position: absolute;
      inset: 0 0 0 auto;
      display: flex;
      flex-direction: column;
      width: min(100%, 27rem);
      background-color: var(--clr-bg);
      border-inline-start: 2px solid var(--clr-ink);
      transform: translateX(100%);
      transition: transform 500ms $ease-in-out;

      &:focus {
        outline: none;
      }

      > header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        border-block-end: 2px solid var(--clr-ink);

        h2 {
          font-size: 2rem;
          font-weight: bold;
          letter-spacing: -0.03em;
          text-transform: uppercase;
        }

        button {
          display: grid;
          place-items: center;
          width: 2.5rem;
          height: 2.5rem;
          background: none;
          border: 2px solid var(--clr-ink);
          border-radius: 50%;
          font-size: 1.1rem;
          transition: transform 300ms $ease-out, background-color 250ms, color 250ms;

          &:is(:hover, :focus-visible) {
            transform: rotate(90deg);
            background-color: var(--clr-ink);
            color: var(--clr-bg);
          }
        }
      }

      > footer {
        padding: 1.25rem 1.5rem 1.5rem;
        border-block-start: 2px solid var(--clr-ink);
      }
    }

    &.is-open &__scrim {
      opacity: 1;
    }

    &.is-open &__panel {
      transform: none;
    }
  }

  .cart-lines {
    flex: 1;
    overflow-y: auto;
    padding-inline: 1.5rem;
  }

  .cart-line {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1.25rem;
    border-block-end: 1px solid color-mix(in srgb, var(--clr-ink) 25%, transparent);
    animation: line-in 400ms $ease-out both;

    &__thumb {
      aspect-ratio: 1;
      border: 2px solid var(--clr-ink);

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    &__name {
      font-weight: bold;
      line-height: 1.2;
      text-decoration: none;
    }

    &__meta {
      font-size: 0.875rem;
      color: var(--clr-muted);
      text-transform: capitalize;
    }

    &__price {
      font-weight: bold;
      align-self: start;
    }
  }

  .qty {
    display: inline-flex;
    align-items: center;
    margin-block-start: 0.5rem;
    border: 2px solid var(--clr-ink);

    button {
      display: grid;
      place-items: center;
      width: 1.75rem;
      height: 1.75rem;
      background: none;
      border: 0;
      font-size: 0.8rem;
      transition: background-color 200ms, color 200ms;

      &:is(:hover, :focus-visible) {
        background-color: var(--clr-ink);
        color: var(--clr-bg);
      }
    }

    span {
      min-width: 1.75rem;
      text-align: center;
      font-size: 0.875rem;
      font-weight: bold;
    }
  }

  .cart-empty {
    flex: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    padding: 2rem;

    p {
      font-family: $font-family-accent;
      font-size: 1.5rem;
    }

    &[hidden] {
      display: none;
    }
  }

  .cart-total {
    display: flex;
    justify-content: space-between;
    font-size: 1.25rem;

    strong {
      font-weight: bold;
    }
  }

  .cart-note {
    font-size: 0.875rem;
    color: var(--clr-muted);
    margin-block-end: 1rem;
  }

  [data-cart-count] {
    display: inline-block;

    &.is-bumped {
      animation: bump 450ms $ease-out;
    }
  }

  @keyframes bump {
    40% {
      transform: scale(1.5) rotate(-8deg);
    }
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateX(1.5rem);
    }
  }
</style>

<script>
  import { cartCount, cartTotal, getCart, getCatalog, money, setQty } from "../scripts/cart";

  const drawer = document.querySelector<HTMLElement>("[data-cart-drawer]")!;
  const panel = drawer.querySelector<HTMLElement>(".cart-drawer__panel")!;
  const list = drawer.querySelector<HTMLElement>("[data-cart-lines]")!;
  const empty = drawer.querySelector<HTMLElement>("[data-cart-empty]")!;
  const footer = drawer.querySelector<HTMLElement>("[data-cart-footer]")!;
  const total = drawer.querySelector<HTMLElement>("[data-cart-total]")!;
  const catalog = getCatalog();
  let lastFocus: HTMLElement | null = null;
  let lastCount = -1;

  const icon = (d: string) =>
    `<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="${d}"/></svg>`;

  function render() {
    const lines = getCart();
    const count = cartCount(lines);

    document.querySelectorAll<HTMLElement>("[data-cart-count]").forEach((el) => {
      el.textContent = `(${count})`;
      if (lastCount !== -1 && count !== lastCount) {
        el.classList.remove("is-bumped");
        void el.offsetWidth;
        el.classList.add("is-bumped");
      }
    });
    lastCount = count;

    list.innerHTML = lines
      .map((line) => {
        const item = catalog[line.id];
        return `
        <li class="cart-line">
          <a class="cart-line__thumb" href="/shop/${line.id}" style="background-color:${item.tile}">
            <img src="${item.image}" alt="" width="120" height="120" />
          </a>
          <div>
            <a class="cart-line__name" href="/shop/${line.id}">${item.name}</a>
            <p class="cart-line__meta">${item.category} · EU ${line.size}</p>
            <div class="qty" data-id="${line.id}" data-size="${line.size}" data-qty="${line.qty}">
              <button type="button" data-step="-1" aria-label="Remove one ${item.name}">${icon("M4 12h16")}</button>
              <span aria-label="Quantity">${line.qty}</span>
              <button type="button" data-step="1" aria-label="Add one ${item.name}">${icon("M12 4v16M4 12h16")}</button>
            </div>
          </div>
          <span class="cart-line__price">${money(item.price * line.qty)}</span>
        </li>`;
      })
      .join("");

    empty.hidden = lines.length > 0;
    list.hidden = footer.hidden = lines.length === 0;
    total.textContent = money(cartTotal(lines));
  }

  function open() {
    lastFocus = document.activeElement as HTMLElement;
    drawer.hidden = false;
    document.body.style.overflow = "hidden";
    requestAnimationFrame(() => requestAnimationFrame(() => drawer.classList.add("is-open")));
    panel.focus();
  }

  function close() {
    if (drawer.hidden) return;
    drawer.classList.remove("is-open");
    document.body.style.overflow = "";
    setTimeout(() => (drawer.hidden = true), 500);
    lastFocus?.focus();
  }

  list.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("button[data-step]");
    if (!button) return;
    const { id, size, qty } = button.parentElement!.dataset;
    setQty(id!, Number(size), Number(qty) + Number(button.dataset.step));
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (target.closest("[data-cart-open]")) open();
    else if (target.closest("[data-cart-close]")) close();
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") close();
    // keep keyboard focus inside the open drawer
    if (event.key === "Tab" && !drawer.hidden) {
      const focusable = panel.querySelectorAll<HTMLElement>("a[href], button:not([disabled])");
      const visible = [...focusable].filter((el) => el.offsetParent !== null);
      const first = visible[0];
      const last = visible[visible.length - 1];
      if (event.shiftKey && (document.activeElement === first || document.activeElement === panel)) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    }
  });

  window.addEventListener("cart:change", render);
  window.addEventListener("cart:open", open);
  window.addEventListener("storage", render);
  render();
</script>
