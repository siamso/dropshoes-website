---
import MainHeader from "./MainHeader.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import CustomCursor from "../utilities/CustomCursor.astro";

const { title, description } = Astro.props;
---

<html lang="en" id="top">
  <MainHeader {title} {description} />
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <CustomCursor />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
