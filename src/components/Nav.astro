---

---
<header>
        <nav>
            <div class="sidebar">
                <h1 class="fs-700">Dropshoes</h1>
                <ul>
                    <li><a href="/">Shop</a></li>
                    <li><a href="/">Collection</a></li>
                    <li><a href="/">About</a></li>
                </ul>
            </div>
            <button class="inkMode__desktop fs-500 fw-bold">Ink Mode</button>
            <button class="cart">Cart</button>
        </nav>
    </div>
</header>
<style lang="scss">
    @use '../styles/abstracts' as *;
    nav{
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }
    .sidebar{
        position: fixed;
        display: flex;
        flex-direction: column;
        padding: 10px;
        width: 100px;
        min-height: 100vh;
        align-items: center;
        justify-content: space-between;

        h1{
            transform: rotate(-90deg);
            margin-block-start: 4.5rem;
            font-family: $font-family-accent;
        }
    }
    .inkMode__desktop{
        font-family: $font-family-accent;
        position: absolute;
        top: 2rem;
        left: 50%;
        background-color: transparent;
        border: none;
        cursor: pointer;

        &::before{
            position: absolute;
            top: 0;
            left: 10px;
            content: '';
            background-color: rgba(255, 166, 0, 0.493);
            width: 60px;
            border-top-left-radius: 30px;
            border-top-right-radius: 5px;
            height: 25px;
        }
    }
    .cart{
        position: fixed;
        top: 2rem;
        right: 2rem;
        background-color: transparent;
        border: none;
    }
</style>