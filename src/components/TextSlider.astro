---
interface Props {
  items?: string[];
  reverse?: boolean;
  tilt?: number;
}
const {
  items = ["Cautious!", "Do Not Scroll"],
  reverse = false,
  tilt = -0.5,
} = Astro.props;
// Each group is wide enough to fill the screen; two groups make the loop seamless.
const repeats = Math.max(2, Math.ceil(16 / items.length));
const group = Array.from({ length: repeats }, () => items).flat();
---

<div class="slider" aria-hidden="true" style={`--tilt: ${tilt}deg`}>
  <div class:list={["track", { reverse }]} data-marquee>
    {
      [0, 1].map(() => (
        <div class="group">
          {group.map((text) => (
            <span>{text}</span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style lang="scss">
  .slider {
    --gap: 3.5rem;

    background-color: var(--clr-tape);
    border-block: 2px solid #000;
    padding: 10px 0;
    // slightly wider than the page so the tilt never shows a corner
    width: 102%;
    margin-inline-start: -1%;
    overflow: hidden;
    user-select: none;
    transform: rotate(var(--tilt));
  }

  .track {
    display: flex;
    width: max-content;
    animation: slide 40s linear infinite;

    &.reverse {
      animation-direction: reverse;
    }
  }

  .group {
    display: flex;
    align-items: center;
    gap: var(--gap);
    padding-inline-end: var(--gap);
    flex-shrink: 0;
  }

  span {
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: bold;
    white-space: nowrap;
    color: #000;
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
