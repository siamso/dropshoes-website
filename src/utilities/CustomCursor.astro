---
const trail = Array.from({ length: 20 });
---

<div class="cursor" data-cursor-root aria-hidden="true">
  {trail.map(() => <div class="circle" data-cursor />)}
</div>

<style lang="scss">
  // The whole trail is blended as one layer, so it stays visible on the cream
  // page, on photos and in Ink Mode alike.
  .cursor {
    position: fixed;
    inset: 0;
    z-index: 400;
    pointer-events: none;
    mix-blend-mode: difference;
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 0s 300ms;

    &.is-active {
      opacity: 1;
      visibility: visible;
      transition: opacity 300ms ease;
    }
  }

  .circle {
    position: absolute;
    top: -12px;
    left: -12px;
    width: 24px;
    height: 24px;
    background-color: #fff;
    border-radius: 50%;
    will-change: transform;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-cursor-root]")!;
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!fine || reduced) {
    root.remove();
  } else {
    const circles = [...root.querySelectorAll<HTMLElement>("[data-cursor]")];
    const points = circles.map(() => ({ x: 0, y: 0 }));
    const mouse = { x: 0, y: 0 };
    let grow = 1;
    let targetGrow = 1;
    let started = false;

    window.addEventListener("mousemove", (event) => {
      mouse.x = event.clientX;
      mouse.y = event.clientY;
      if (!started) {
        started = true;
        points.forEach((point) => Object.assign(point, mouse));
        root.classList.add("is-active");
      }
      const target = event.target as Element | null;
      targetGrow = target?.closest("a, button, summary, label, input, select, [data-cursor-grow]") ? 2.4 : 1;
    });

    document.addEventListener("mouseleave", () => root.classList.remove("is-active"));
    document.addEventListener("mouseenter", () => started && root.classList.add("is-active"));

    (function animatedCursor() {
      let x = mouse.x;
      let y = mouse.y;
      grow += (targetGrow - grow) * 0.18;

      circles.forEach((circle, index) => {
        const scale = ((circles.length - index) / circles.length) * (index === 0 ? grow : 1);
        circle.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${scale})`;
        points[index].x = x;
        points[index].y = y;

        const next = points[index + 1] || points[0];
        x += (next.x - x) * 0.4;
        y += (next.y - y) * 0.4;
      });

      requestAnimationFrame(animatedCursor);
    })();
  }
</script>
